{
  "name": "dsh-client-ui-edit-resend",
  "version": "0.1.0",
  "description": "Edit-and-resend for sent user messages: an edit button on each user message that returns its text and attachments to the composer draft.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "lib/client.js",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-cordis-client-runner"
      ]
    }
  },
  "license": "MIT"
}
