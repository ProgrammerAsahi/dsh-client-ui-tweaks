{
  "name": "dsh-client-ui-tweaks",
  "version": "0.2.0",
  "description": "Assorted dsh UI tweaks: edit-and-resend for user messages with branch switching, sidebar branch-family grouping, unified branch titles.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "lib/client.js",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-cordis-client-runner"
      ]
    }
  },
  "license": "MIT"
}
